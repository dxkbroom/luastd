#!/usr/bin/env python3
#MISE description="Reorder Lua Kotlin test ports to match Kotlin source order"
#USAGE arg "[FILES]..." help="Port files (default: crates/luastd_runtime/tests/lua/kotlinx/*.lua)"
"""Reorder test blocks in Lua ports to match their referenced Kotlin source."""

from __future__ import annotations

import os
import sys
from pathlib import Path

ROOT = Path(os.environ.get("MISE_PROJECT_ROOT") or Path(__file__).resolve().parents[3])
sys.path.insert(0, str(ROOT / "xtasks/lib"))

from kotlin_coverage import KOTLIN_TEST_TAG, kotlin_class_test_methods, parse_port, reorder_lua_tests
from kotlin_coverage import inherited_test_methods, kotlin_source, kotlin_test_sources

PORTS = ROOT / "crates/luastd_runtime/tests/lua/kotlinx"
KOTLINX = Path(os.environ.get("KOTLINX_DIR") or ROOT.parent / "kotlinx.coroutines")


def main(argv: list[str]) -> int:
    files = [Path(arg) for arg in argv]
    if not files:
        files = sorted(PORTS.glob("*.lua"))
    inventory, _ = kotlin_test_sources(KOTLINX, KOTLIN_TEST_TAG)
    abstract_methods = inherited_test_methods(inventory)
    failed = False
    for file in files:
        ports, issues = parse_port(file)
        if issues:
            print(f"skip {file}: " + "; ".join(issue.message for issue in issues), file=sys.stderr)
            failed = True
            continue
        updated = file.read_text()
        for port in ports:
            source = kotlin_source(port.path, port.tag, KOTLINX)
            if source is None:
                print(f"skip {file}: cannot read {port.path}@{port.tag}", file=sys.stderr)
                failed = True
                updated = ""
                break
            expected = kotlin_class_test_methods(source, port.cls, abstract_methods)
            mapped = {test.name for test in port.tests}
            if set(expected) != mapped:
                print(f"skip {file}: Kotlin and Lua test names differ for {port.cls}", file=sys.stderr)
                failed = True
                updated = ""
                break
            updated = reorder_lua_tests(updated, expected)
        if updated and updated != file.read_text():
            file.write_text(updated)
            print(f"formatted {file}")
    return 1 if failed else 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
